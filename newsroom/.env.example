# === LLM ===
ANTHROPIC_API_KEY=your_anthropic_key_here

# === Search ===
# Tavily: https://app.tavily.com — $0.01/request, najlepsza jakość dla agentów
TAVILY_API_KEY=your_tavily_key_here
# DuckDuckGo używane automatycznie jako fallback (bezpłatne, bez klucza)

# === Newsroom ===
# Język artykułów: pl lub en
NEWSROOM_LANGUAGE=pl
# Max słów w artykule
NEWSROOM_MAX_WORDS=900
# Max revisji przed odrzuceniem artykułu
NEWSROOM_MAX_REVISIONS=2
# Minimalny score fact-checkera do publikacji (0.0–1.0)
NEWSROOM_MIN_FACT_SCORE=0.7
# Katalog outputu (względny lub bezwzględny)
NEWSROOM_OUTPUT_DIR=output
# Katalog checkpointów LangGraph (SQLite)
NEWSROOM_CHECKPOINTS_DIR=checkpoints

# === API ===
# Klucz do autoryzacji FastAPI (Bearer token)
API_SECRET_KEY=change_me_before_deploy
API_HOST=0.0.0.0
API_PORT=8000

# === RSS Feeds (oddzielone przecinkami) ===
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml

# === LangSmith (opcjonalne — tracing i observability) ===
# Klucz z https://smith.langchain.com → Settings → API Keys
# Zostaw puste żeby wyłączyć tracing
LANGSMITH_API_KEY=
# Nazwa projektu widoczna w LangSmith UI
LANGSMITH_PROJECT=newsroom

# === Logowanie ===
LOG_LEVEL=INFO
# JSON (produkcja) lub console (development)
LOG_FORMAT=console
